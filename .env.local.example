# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real credentials.

# ----- Supabase -----
# Project Settings → API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----- Anthropic (added at Step 7) -----
ANTHROPIC_API_KEY=

# ----- Google Drive (added at Step 3) -----
# Path to the service account JSON file (relative to repo root, gitignored)
GOOGLE_SERVICE_ACCOUNT_JSON=./google-credentials.json
# The Drive folder ID for the Honours Boards root
# (My Drive → Signet → Honours Boards Case Studies)
HONOURS_BOARDS_DRIVE_ROOT_ID=

# ----- Wix (added at Step 10) -----
WIX_API_KEY=
WIX_SITE_ID_HONOURS_BOARDS=
WIX_SITE_ID_SIGNET_SIGNS=
WIX_SITE_ID_SIGNET_PLAY=

# ----- dotdigital (Email module) -----
# Region from your dotdigital dashboard URL: r1=UK, r2=US, r3=AU.
DOTDIGITAL_API_BASE=https://r1-api.dotdigital.com
# Settings → Access → API users in dotdigital. Email-shaped username + password.
DOTDIGITAL_API_USER=
DOTDIGITAL_API_PASSWORD=
